TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
# JSON array of Telegram user IDs allowed to use the bot
TELEGRAM_ALLOWED_USER_IDS=[123456789]
# Generate one with: python -c "import secrets; print(secrets.token_urlsafe(32))"
TELEGRAM_WEBHOOK_SECRET=<replace-with-random-secret>
# Maximum Telegram updates processed concurrently by each worker process
TELEGRAM_UPDATE_WORKER_CONCURRENCY=4
TELEGRAM_UPDATE_WORKER_POLL_INTERVAL_SECONDS=1.0
# Must exceed the expected duration of external calls made by update handlers
TELEGRAM_UPDATE_WORKER_CLAIM_TIMEOUT_SECONDS=300.0
TELEGRAM_UPDATE_WORKER_RECOVERY_INTERVAL_SECONDS=30.0
TELEGRAM_UPDATE_WORKER_SHUTDOWN_GRACE_PERIOD_SECONDS=10.0
# Time zone for task dates that do not include one. Use an IANA name.
USER_TIMEZONE=Europe/Moscow

SINGULARITY_API_TOKEN=your_singularity_token

DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/productivity_bot

WEBHOOK_BASE_URL=https://example.com
